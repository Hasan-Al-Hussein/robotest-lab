#!/bin/sh
set -eu

robotest-supervisor -h >/dev/null 2>&1
robotest-supervisor \
  -check-config \
  -config /etc/robotest-supervisor/config.json \
  | grep -Fx 'configuration valid'
python3 -m json.tool /etc/robotest-supervisor/config.json >/dev/null
python3 - /etc/robotest-supervisor/config.json <<'PY'
import json
import pathlib
import sys

value = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8'))
state_directory = value['state_directory']
children = value['children']
if len(children) != 1:
    raise SystemExit('installed config must contain exactly one child')
child = children[0]
if child['environment'].get('ROBOTEST_RUNTIME_STATE_DIRECTORY') != state_directory:
    raise SystemExit('runtime state environment does not match state_directory')
if child.get('heartbeat_file') != f'{state_directory}/robotest-stack.heartbeat':
    raise SystemExit('heartbeat_file does not match the runtime state contract')
PY
test -x /usr/libexec/robotest-supervisor/start-robotest-stack
test -f /usr/lib/systemd/system/robotest-supervisor.service
grep -Fx 'ConditionPathExists=/opt/robotest-lab/install/setup.bash' \
  /usr/lib/systemd/system/robotest-supervisor.service
grep -Fx 'CPUAffinity=0-5' \
  /usr/lib/systemd/system/robotest-supervisor.service
systemd-analyze verify /usr/lib/systemd/system/robotest-supervisor.service

wrapper_log=$(mktemp)
cleanup() {
  rm -f -- "${wrapper_log}"
}
trap cleanup 0 1 2 15

expect_wrapper_rejection() {
  expected_message=$1
  runtime_directory=$2
  if ROBOTEST_RUNTIME_STATE_DIRECTORY="${runtime_directory}" \
    /usr/libexec/robotest-supervisor/start-robotest-stack \
    >"${wrapper_log}" 2>&1; then
    printf 'wrapper accepted invalid runtime directory: %s\n' "${runtime_directory}" >&2
    return 1
  else
    wrapper_status=$?
  fi
  test "${wrapper_status}" -eq 64
  grep -F "${expected_message}" "${wrapper_log}" >/dev/null
}

expect_wrapper_rejection \
  'path must be /var/lib/robotest-supervisor or one of its descendants' \
  /tmp
expect_wrapper_rejection \
  'path must be canonical' \
  /var/lib/robotest-supervisor/../robotest-supervisor

python3 - /usr/libexec/robotest-supervisor/start-robotest-stack <<'PY'
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import shlex
import signal
import stat
import subprocess
import sys
import tempfile
import textwrap
import time


LAUNCHER = r'''#!/usr/bin/python3
