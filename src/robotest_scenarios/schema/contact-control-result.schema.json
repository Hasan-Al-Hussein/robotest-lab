{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotest.local/schema/contact-control-result-v1.json",
  "title": "RoboTest collision positive-control component result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "producer", "status", "verdict", "identity",
    "configuration", "control", "cleanup", "quality"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "producer": {"const": "robotest_scenarios/contact_control_driver"},
    "status": {"enum": ["PASS", "FAIL"]},
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "benchmark_pass", "exit_code", "reason"],
      "properties": {
        "authority": {"const": "component_only"},
        "benchmark_pass": {"type": "null"},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "reason": {"type": "string", "maxLength": 4096}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "fixture_id", "scenario_sha256"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "fixture_id": {"const": "collision_positive_control"},
        "scenario_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_configuration", "control_configuration_sha256",
        "coverage_manifest_path", "coverage_manifest_provenance", "coverage_manifest_sha256", "expected_pair",
        "fixture", "fixture_sha256", "service_timeout_s", "source_binding",
        "wall_asset_sha256", "wall_timeout_s"
      ],
      "properties": {
        "control_configuration": {"type": "object"},
        "control_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "coverage_manifest_path": {"type": "string", "maxLength": 4096},
        "coverage_manifest_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bridge_sha256", "contact_configuration_sha256", "coverage_manifest_sha256", "rendered_sdf_sha256", "robot_description_sha256", "world_source_sha256"],
          "properties": {
            "bridge_sha256": {"$ref": "#/$defs/sha256"},
            "contact_configuration_sha256": {"$ref": "#/$defs/sha256"},
            "coverage_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "rendered_sdf_sha256": {"$ref": "#/$defs/sha256"},
            "robot_description_sha256": {"$ref": "#/$defs/sha256"},
            "world_source_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "coverage_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "expected_pair": {"$ref": "#/$defs/pair"},
        "fixture": {"type": "object"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "service_timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
        "source_binding": {"type": "object"},
        "wall_asset_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "wall_timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 30}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "command_trace", "contact", "criteria", "metrics_owned", "observed_robot_start", "setup", "timeline"],
      "properties": {
        "arm": {"$ref": "#/$defs/armEvidence"},
        "command_trace": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/command"}},
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active_counterpart_count", "classified_record_count", "contact_clock_bracket",
            "counterpart_tracker_count", "episodes", "exact_pair_snapshot_record_count",
            "expected_pair", "first_qualifying_contact", "release_snapshot",
            "snapshot_contact_record_count", "snapshot_records", "snapshots"
          ],
          "properties": {
            "active_counterpart_count": {"type": "integer", "minimum": 0},
            "classified_record_count": {"type": "integer", "minimum": 0},
            "contact_clock_bracket": {"anyOf": [{"$ref": "#/$defs/contactClockBracket"}, {"type": "null"}]},
            "counterpart_tracker_count": {"type": "integer", "minimum": 1, "maximum": 32768},
            "episodes": {"type": "array", "maxItems": 32768, "items": {"$ref": "#/$defs/episode"}},
            "exact_pair_snapshot_record_count": {"type": "integer", "minimum": 0},
            "expected_pair": {"$ref": "#/$defs/pair"},
            "first_qualifying_contact": {
              "anyOf": [{"$ref": "#/$defs/firstQualifyingContact"}, {"type": "null"}]
            },
            "release_snapshot": {"anyOf": [{"$ref": "#/$defs/releaseSnapshot"}, {"type": "null"}]},
            "snapshot_contact_record_count": {"type": "integer", "minimum": 0},
            "snapshot_records": {"type": "array", "maxItems": 32768, "items": {"$ref": "#/$defs/snapshotContactRecord"}},
            "snapshots": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/contactSnapshot"}}
          }
        },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contact_before_deadline", "episode_reconciled",
            "exactly_one_counterpart_episode", "final_command_zero",
            "graph_isolated", "hold_completed", "overflow_free",
            "expected_contact_snapshot_observed", "release_completed", "release_source_spanned",
            "reverse_completed", "robot_start_verified", "sole_cmd_vel_publisher", "stop_within_100ms",
            "wall_deleted"
          ],
          "properties": {
            "contact_before_deadline": {"type": "boolean"},
            "episode_reconciled": {"type": "boolean"},
            "exactly_one_counterpart_episode": {"type": "boolean"},
            "final_command_zero": {"type": "boolean"},
            "graph_isolated": {"type": "boolean"},
            "hold_completed": {"type": "boolean"},
            "overflow_free": {"type": "boolean"},
            "expected_contact_snapshot_observed": {"type": "boolean"},
            "release_completed": {"type": "boolean"},
            "release_source_spanned": {"type": "boolean"},
            "reverse_completed": {"type": "boolean"},
            "robot_start_verified": {"type": "boolean"},
            "sole_cmd_vel_publisher": {"type": "boolean"},
            "stop_within_100ms": {"type": "boolean"},
            "wall_deleted": {"type": "boolean"}
          }
        },
        "metrics_owned": {"type": "object"},
        "observed_robot_start": {"type": ["object", "null"]},
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed_robot_start", "observed_wall", "spawn"],
          "properties": {
            "observed_robot_start": {"type": ["object", "null"]},
            "observed_wall": {"type": ["object", "null"]},
            "spawn": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attempt_count", "error", "request_sequence", "request_stamp_ns", "response_sequence", "response_stamp_ns", "success"],
              "properties": {
                "attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
                "error": {"type": ["string", "null"], "maxLength": 4096},
                "request_sequence": {"type": ["integer", "null"], "minimum": 1},
                "request_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
                "response_sequence": {"type": ["integer", "null"], "minimum": 1},
                "response_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
                "success": {"type": ["boolean", "null"]}
              }
            }
          }
        },
        "timeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control_started_stamp_ns", "control_started_steady_ns", "final_zero_stamp_ns", "hold_complete_stamp_ns",
            "release_complete_stamp_ns", "release_contact_snapshot_start_count", "release_contact_snapshot_end_count",
            "release_observed_clock_stamp_ns", "release_qualified_snapshot_stamp_ns",
            "release_required_through_stamp_ns", "reverse_start_stamp_ns",
            "stop_command_stamp_ns", "stop_latency_clock_stamp_ns", "stop_latency_ns"
          ],
          "properties": {
            "control_started_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "control_started_steady_ns": {"type": ["integer", "null"], "minimum": 1},
            "final_zero_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "hold_complete_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "release_complete_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "release_contact_snapshot_start_count": {"type": ["integer", "null"], "minimum": 0},
            "release_contact_snapshot_end_count": {"type": "integer", "minimum": 0},
            "release_observed_clock_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "release_qualified_snapshot_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "release_required_through_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "reverse_start_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "stop_command_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "stop_latency_clock_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "stop_latency_ns": {"type": ["integer", "null"]}
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "delete_attempt_count", "delete_success", "actor_absent", "proof"],
      "properties": {
        "required": {"type": "boolean"},
        "delete_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "delete_success": {"type": ["boolean", "null"]},
        "actor_absent": {"type": "boolean"},
        "proof": {"type": "object"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_buffers_bounded", "buffers", "collision_monitor_absent", "contact_graph_topology",
        "forbidden_nodes", "nav2_absent", "overflow_free", "protocol_error_count",
        "clock", "public_contact_snapshot_heartbeat", "public_contact_snapshot_stream",
        "relative_project_names", "sole_cmd_vel_publisher", "source_publisher_counts",
        "source_publisher_missing_observation_count", "source_streams_live",
        "cmd_vel_publisher_count"
      ],
      "properties": {
        "all_buffers_bounded": {"const": true},
        "buffers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_state", "command", "contact_snapshot_records", "contact_snapshots", "ground_truth"],
          "properties": {
            "actor_state": {"$ref": "#/$defs/buffer"},
            "command": {"$ref": "#/$defs/buffer"},
            "contact_snapshot_records": {"$ref": "#/$defs/buffer"},
            "contact_snapshots": {"$ref": "#/$defs/buffer"},
            "ground_truth": {"$ref": "#/$defs/buffer"}
          }
        },
        "collision_monitor_absent": {"type": "boolean"},
        "contact_graph_topology": {"$ref": "#/$defs/contactGraphTopologyEvidence"},
        "clock": {"$ref": "#/$defs/clock"},
        "public_contact_snapshot_heartbeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "first_stamp_ns", "future_delivery_count", "latest_stamp_ns", "max_gap_ns",
            "pre_clock_discard_count", "snapshot_count"
          ],
          "properties": {
            "first_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "future_delivery_count": {"type": "integer", "minimum": 0},
            "latest_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
            "max_gap_ns": {"type": "integer", "minimum": 0},
            "pre_clock_discard_count": {"type": "integer", "minimum": 0},
            "snapshot_count": {"type": "integer", "minimum": 0}
          }
        },
        "forbidden_nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "nav2_absent": {"type": "boolean"},
        "overflow_free": {"type": "boolean"},
        "protocol_error_count": {"type": "integer", "minimum": 0},
        "public_contact_snapshot_stream": {"$ref": "#/$defs/buffer"},
        "relative_project_names": {"const": true},
        "sole_cmd_vel_publisher": {"type": "boolean"},
        "source_publisher_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contacts", "entity_pose", "ground_truth"],
          "properties": {
            "contacts": {"type": "integer", "minimum": 0},
            "entity_pose": {"type": "integer", "minimum": 0},
            "ground_truth": {"type": "integer", "minimum": 0}
          }
        },
        "source_publisher_missing_observation_count": {"type": "integer", "minimum": 0},
        "source_streams_live": {"type": "boolean"},
        "cmd_vel_publisher_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {
        "properties": {
          "verdict": {"properties": {"exit_code": {"const": 0}}},
          "configuration": {
            "properties": {
              "control_configuration": {"type": "object", "minProperties": 1},
              "fixture": {"$ref": "#/$defs/fixture"},
              "source_binding": {"$ref": "#/$defs/sourceBinding"}
            }
          },
          "cleanup": {
            "properties": {
              "actor_absent": {"const": true},
              "delete_attempt_count": {"const": 1},
              "delete_success": {"const": true},
              "proof": {"$ref": "#/$defs/cleanupProof"},
              "required": {"const": true}
            }
          },
          "control": {
            "properties": {
              "arm": {"$ref": "#/$defs/passingArmEvidence"},
              "command_trace": {
                "minItems": 5,
                "contains": {
                  "required": ["angular_z", "linear_x", "phase"],
                  "properties": {
                    "angular_z": {"const": 0.0},
                    "linear_x": {"const": 0.0},
                    "phase": {"const": "HOLD"}
                  }
                },
                "minContains": 1
              },
              "contact": {
                "properties": {
                  "classified_record_count": {"minimum": 1},
                  "episodes": {"minItems": 1},
                  "contact_clock_bracket": {"$ref": "#/$defs/contactClockBracket"},
                  "exact_pair_snapshot_record_count": {"minimum": 1},
                  "first_qualifying_contact": {"$ref": "#/$defs/firstQualifyingContact"},
                  "release_snapshot": {"$ref": "#/$defs/releaseSnapshot"},
                  "snapshot_contact_record_count": {"minimum": 1},
                  "snapshot_records": {"minItems": 1},
                  "snapshots": {"minItems": 1}
                }
              },
              "criteria": {"$ref": "#/$defs/passingCriteria"},
              "metrics_owned": {"$ref": "#/$defs/metricsOwned"},
              "observed_robot_start": {"$ref": "#/$defs/observedRobotStart"},
              "setup": {
                "properties": {
                  "observed_robot_start": {"$ref": "#/$defs/observedRobotStart"},
                  "observed_wall": {"$ref": "#/$defs/observedWall"},
                  "spawn": {
                    "properties": {
                      "attempt_count": {"const": 1},
                      "error": {"type": "null"},
                      "request_sequence": {"type": "integer", "minimum": 1},
                      "request_stamp_ns": {"type": "integer", "minimum": 0},
                      "response_sequence": {"type": "integer", "minimum": 1},
                      "response_stamp_ns": {"type": "integer", "minimum": 0},
                      "success": {"const": true}
                    }
                  }
                }
              },
              "timeline": {
                "properties": {
                  "control_started_steady_ns": {"type": "integer", "minimum": 1},
                  "release_contact_snapshot_end_count": {"minimum": 2},
                  "release_contact_snapshot_start_count": {"type": "integer", "minimum": 1},
                  "release_observed_clock_stamp_ns": {"type": "integer", "minimum": 1},
                  "release_qualified_snapshot_stamp_ns": {"type": "integer", "minimum": 1}
                }
              }
            }
          },
          "quality": {
            "properties": {
              "collision_monitor_absent": {"const": true},
              "contact_graph_topology": {
                "properties": {
                  "audit_count": {"minimum": 2},
                  "first_sha256": {"$ref": "#/$defs/sha256"},
                  "first_snapshot": {"$ref": "#/$defs/contactGraphSnapshot"},
                  "last_sha256": {"$ref": "#/$defs/sha256"},
                  "last_snapshot": {"$ref": "#/$defs/contactGraphSnapshot"}
                }
              },
              "nav2_absent": {"const": true},
              "overflow_free": {"const": true},
              "protocol_error_count": {"const": 0},
              "forbidden_nodes": {"maxItems": 0},
              "sole_cmd_vel_publisher": {"const": true},
              "source_streams_live": {"const": true}
            }
          }
        }
      },
      "else": {"properties": {"verdict": {"properties": {"exit_code": {"enum": [20, 21, 22, 23, 24]}}}}}
    }
  ],
  "$defs": {
    "armRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action", "arm_protocol_sha256", "arm_requested_steady_ns", "producer",
        "ready_sha256", "run_id", "runtime_gate_sha256", "schema_version"
      ],
      "properties": {
        "action": {"const": "start_positive_control_motion"},
        "arm_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "arm_requested_steady_ns": {"type": "integer", "minimum": 1},
        "producer": {"const": "robotest_phase3/benchmark_runner"},
        "ready_sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "runtime_gate_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": 2}
      }
    },
    "commandDeliveryProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector_progress_observed_steady_ns", "collector_progress_sha256",
        "collector_progress_stamp_ns", "matched_subscription_count",
        "match_observed_steady_ns", "probe_publish_returned_steady_ns",
        "probe_publish_started_steady_ns", "probe_sim_stamp_ns",
        "required_subscription_count"
      ],
      "properties": {
        "collector_progress_observed_steady_ns": {"type": "integer", "minimum": 1},
        "collector_progress_sha256": {"$ref": "#/$defs/sha256"},
        "collector_progress_stamp_ns": {"type": "integer", "minimum": 1},
        "matched_subscription_count": {"const": 2},
        "match_observed_steady_ns": {"type": "integer", "minimum": 1},
        "probe_publish_returned_steady_ns": {"type": "integer", "minimum": 1},
        "probe_publish_started_steady_ns": {"type": "integer", "minimum": 1},
        "probe_sim_stamp_ns": {"type": "integer", "minimum": 1},
        "required_subscription_count": {"const": 2}
      }
    },
    "armedAcknowledgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_observed_clock_sample_count", "arm_observed_sim_stamp_ns",
        "arm_observed_steady_ns", "arm_protocol_sha256", "arm_request_sha256",
        "arm_requested_steady_ns", "armed_clock_sample_count", "armed_sim_stamp_ns",
        "armed_steady_ns", "command_delivery_probe", "producer", "ready_sha256", "run_id",
        "runtime_gate_sha256", "schema_version"
      ],
      "properties": {
        "arm_observed_clock_sample_count": {"type": "integer", "minimum": 1},
        "arm_observed_sim_stamp_ns": {"type": "integer", "minimum": 1},
        "arm_observed_steady_ns": {"type": "integer", "minimum": 1},
        "arm_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "arm_request_sha256": {"$ref": "#/$defs/sha256"},
        "arm_requested_steady_ns": {"type": "integer", "minimum": 1},
        "armed_clock_sample_count": {"type": "integer", "minimum": 1},
        "armed_sim_stamp_ns": {"type": "integer", "minimum": 1},
        "armed_steady_ns": {"type": "integer", "minimum": 1},
        "command_delivery_probe": {"$ref": "#/$defs/commandDeliveryProbe"},
        "producer": {"const": "robotest_scenarios/contact_control_driver"},
        "ready_sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "runtime_gate_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": 2}
      }
    },
    "armEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acknowledgment", "acknowledgment_sha256",
        "first_nonzero_publish_returned_steady_ns",
        "first_nonzero_publish_started_steady_ns", "request", "request_sha256"
      ],
      "properties": {
        "acknowledgment": {"anyOf": [{"$ref": "#/$defs/armedAcknowledgment"}, {"type": "null"}]},
        "acknowledgment_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "first_nonzero_publish_returned_steady_ns": {"type": ["integer", "null"], "minimum": 1},
        "first_nonzero_publish_started_steady_ns": {"type": ["integer", "null"], "minimum": 1},
        "request": {"anyOf": [{"$ref": "#/$defs/armRequest"}, {"type": "null"}]},
        "request_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "passingArmEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acknowledgment", "acknowledgment_sha256",
        "first_nonzero_publish_returned_steady_ns",
        "first_nonzero_publish_started_steady_ns", "request", "request_sha256"
      ],
      "properties": {
        "acknowledgment": {"$ref": "#/$defs/armedAcknowledgment"},
        "acknowledgment_sha256": {"$ref": "#/$defs/sha256"},
        "first_nonzero_publish_returned_steady_ns": {"type": "integer", "minimum": 1},
        "first_nonzero_publish_started_steady_ns": {"type": "integer", "minimum": 1},
        "request": {"$ref": "#/$defs/armRequest"},
        "request_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "cleanupProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "pose_source_publishers_after", "pose_source_publishers_before",
        "post_delete_pose_count", "post_delete_pose_source_heartbeat_count",
        "post_delete_pose_source_latest_sim_stamp_ns", "quiet_until_sim_stamp_ns",
        "request_sequence", "request_stamp_ns", "response_sequence", "response_stamp_ns"
      ],
      "properties": {
        "kind": {"const": "successful_delete_response_and_pose_quiet_interval"},
        "pose_source_publishers_after": {"type": "integer", "minimum": 1},
        "pose_source_publishers_before": {"type": "integer", "minimum": 1},
        "post_delete_pose_count": {"const": 0},
        "post_delete_pose_source_heartbeat_count": {"type": "integer", "minimum": 1},
        "post_delete_pose_source_latest_sim_stamp_ns": {"type": "integer", "minimum": 1},
        "quiet_until_sim_stamp_ns": {"type": "integer", "minimum": 1},
        "request_sequence": {"type": "integer", "minimum": 1},
        "request_stamp_ns": {"type": "integer", "minimum": 0},
        "response_sequence": {"type": "integer", "minimum": 1},
        "response_stamp_ns": {"type": "integer", "minimum": 0}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["angular_z", "collector_sequence", "linear_x", "phase", "sim_stamp_ns"],
      "properties": {
        "angular_z": {"const": 0.0},
        "collector_sequence": {"type": "integer", "minimum": 1},
        "linear_x": {"enum": [-0.05, 0.0, 0.05]},
        "phase": {
          "enum": [
            "CONTACT_STOP", "FAIL_SAFE_ZERO", "FINAL_ZERO", "FORWARD", "HOLD",
            "LATE_CONTACT_FAIL_SAFE_ZERO", "REVERSE"
          ]
        },
        "sim_stamp_ns": {"type": "integer", "minimum": 1}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control", "entity", "expected_pair", "fixture_id", "robot_start", "schema_version"
      ],
      "properties": {
        "control": {"type": "object", "minProperties": 1},
        "entity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_sha256", "name", "pose"],
          "properties": {
            "asset_sha256": {"$ref": "#/$defs/sha256"},
            "name": {"const": "phase3_contact_control_wall"},
            "pose": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "yaw", "z"],
              "properties": {
                "x": {"type": "number"},
                "y": {"type": "number"},
                "yaw": {"type": "number"},
                "z": {"type": "number"}
              }
            }
          }
        },
        "expected_pair": {"$ref": "#/$defs/pair"},
        "fixture_id": {"const": "collision_positive_control"},
        "robot_start": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "yaw"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "yaw": {"type": "number"}
          }
        },
        "schema_version": {"const": 1}
      }
    },
    "metricsOwned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector_reconciliation_and_process_group_termination"],
      "properties": {
        "collector_reconciliation_and_process_group_termination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "required", "scenario_controller_value"],
          "properties": {
            "owner": {"const": "robotest_metrics_and_orchestrator"},
            "required": {"const": true},
            "scenario_controller_value": {"type": "null"}
          }
        }
      }
    },
    "observedRobotStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment_error_ns", "collector_sequence", "position_error_m", "sim_stamp_ns",
        "x", "y", "yaw", "yaw_error_rad"
      ],
      "properties": {
        "alignment_error_ns": {"type": "integer", "minimum": 0},
        "collector_sequence": {"type": "integer", "minimum": 1},
        "position_error_m": {"type": "number", "minimum": 0},
        "sim_stamp_ns": {"type": "integer", "minimum": 1},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "yaw": {"type": "number"},
        "yaw_error_rad": {"type": "number", "minimum": 0}
      }
    },
    "observedWall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector_sequence", "position_error_m", "stamp_ns", "x", "y", "yaw",
        "yaw_error_rad", "z"
      ],
      "properties": {
        "collector_sequence": {"type": "integer", "minimum": 1},
        "position_error_m": {"type": "number", "minimum": 0},
        "stamp_ns": {"type": "integer", "minimum": 1},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "yaw": {"type": "number"},
        "yaw_error_rad": {"type": "number", "minimum": 0},
        "z": {"type": "number"}
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counterpart_model", "end_stamp_ns", "normalized_pairs", "snapshot_record_count", "start_stamp_ns"],
      "properties": {
        "counterpart_model": {"type": "string", "minLength": 1, "maxLength": 4096},
        "end_stamp_ns": {"type": "integer", "minimum": 1},
        "normalized_pairs": {"type": "array", "minItems": 1, "maxItems": 32768, "uniqueItems": true, "items": {"$ref": "#/$defs/pair"}},
        "snapshot_record_count": {"type": "integer", "minimum": 1},
        "start_stamp_ns": {"type": "integer", "minimum": 1}
      }
    },
    "contactClockBracket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock_stamp_ns", "lag_ns", "limit_ns", "snapshot_stamp_ns"],
      "properties": {
        "clock_stamp_ns": {"type": "integer", "minimum": 1},
        "lag_ns": {"type": "integer", "minimum": 0, "maximum": 220000000},
        "limit_ns": {"const": 220000000},
        "snapshot_stamp_ns": {"type": "integer", "minimum": 1}
      }
    },
    "contactGraphTopologyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_count", "first_sha256", "first_snapshot", "last_sha256", "last_snapshot"
      ],
      "properties": {
        "audit_count": {"type": "integer", "minimum": 0},
        "first_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "first_snapshot": {"anyOf": [{"$ref": "#/$defs/contactGraphSnapshot"}, {"type": "null"}]},
        "last_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "last_snapshot": {"anyOf": [{"$ref": "#/$defs/contactGraphSnapshot"}, {"type": "null"}]}
      }
    },
    "contactGraphSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_raw_publishers", "private_raw_subscribers", "public_snapshot_publishers",
        "topics"
      ],
      "properties": {
        "private_raw_publishers": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"$ref": "#/$defs/contactGraphEndpoint"}
        },
        "private_raw_subscribers": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"$ref": "#/$defs/contactGraphEndpoint"}
        },
        "public_snapshot_publishers": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"$ref": "#/$defs/contactGraphEndpoint"}
        },
        "topics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["private_raw_contact_topic", "public_contact_snapshot_topic"],
          "properties": {
            "private_raw_contact_topic": {"const": "/robotest/internal/raw_contacts"},
            "public_contact_snapshot_topic": {"const": "/robotest/validation/contacts"}
          }
        }
      }
    },
    "contactGraphEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_gid", "node_fqn", "qos", "qos_status", "topic_type"],
      "properties": {
        "endpoint_gid": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "node_fqn": {"enum": ["/robotest/contact_stream_gate", "/robotest/parameter_bridge"]},
        "qos": {
          "type": "object",
          "additionalProperties": false,
          "required": ["depth", "durability", "history", "reliability"],
          "properties": {
            "depth": {"type": "integer", "minimum": 0},
            "durability": {"const": "VOLATILE"},
            "history": {"enum": ["KEEP_LAST", "SYSTEM_DEFAULT", "UNKNOWN"]},
            "reliability": {"const": "RELIABLE"}
          }
        },
        "qos_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "depth_matches_or_unknown", "durability_volatile",
            "history_keep_last_or_unknown", "reliability_reliable"
          ],
          "properties": {
            "depth_matches_or_unknown": {"const": true},
            "durability_volatile": {"const": true},
            "history_keep_last_or_unknown": {"const": true},
            "reliability_reliable": {"const": true}
          }
        },
        "topic_type": {"const": "ros_gz_interfaces/msg/Contacts"}
      }
    },
    "releaseSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector_sequence", "sim_stamp_ns"],
      "properties": {
        "collector_sequence": {"type": "integer", "minimum": 1},
        "sim_stamp_ns": {"type": "integer", "minimum": 1}
      }
    },
    "contactSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classified_count", "collector_sequence", "counted_snapshot_records",
        "delivery_clock_offset_ns", "delivery_clock_stamp_ns", "exact_pair_count",
        "sim_stamp_ns", "snapshot_record_count"
      ],
      "properties": {
        "classified_count": {"type": "integer", "minimum": 0, "maximum": 16},
        "collector_sequence": {"type": "integer", "minimum": 1},
        "counted_snapshot_records": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "counterpart_model", "normalized_pair", "record_sequence",
              "snapshot_sequence"
            ],
            "properties": {
              "counterpart_model": {"type": "string", "minLength": 1, "maxLength": 4096},
              "normalized_pair": {"$ref": "#/$defs/pair"},
              "record_sequence": {"type": "integer", "minimum": 1},
              "snapshot_sequence": {"type": "integer", "minimum": 1}
            }
          }
        },
        "delivery_clock_offset_ns": {"type": "integer"},
        "delivery_clock_stamp_ns": {"type": "integer", "minimum": 0},
        "exact_pair_count": {"type": "integer", "minimum": 0, "maximum": 16},
        "sim_stamp_ns": {"type": "integer", "minimum": 1},
        "snapshot_record_count": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "passingCriteria": {
      "type": "object",
      "properties": {
        "contact_before_deadline": {"const": true},
        "episode_reconciled": {"const": true},
        "exactly_one_counterpart_episode": {"const": true},
        "final_command_zero": {"const": true},
        "graph_isolated": {"const": true},
        "hold_completed": {"const": true},
        "overflow_free": {"const": true},
        "expected_contact_snapshot_observed": {"const": true},
        "release_completed": {"const": true},
        "release_source_spanned": {"const": true},
        "reverse_completed": {"const": true},
        "robot_start_verified": {"const": true},
        "sole_cmd_vel_publisher": {"const": true},
        "stop_within_100ms": {"const": true},
        "wall_deleted": {"const": true}
      }
    },
    "snapshotContactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector_sequence", "counterpart_collision", "counterpart_model", "disposition", "normalized_pair", "robot_collision", "sim_stamp_ns", "snapshot_sequence"],
      "properties": {
        "collector_sequence": {"type": "integer", "minimum": 1},
        "counterpart_collision": {"type": ["string", "null"], "maxLength": 4096},
        "counterpart_model": {"type": ["string", "null"], "maxLength": 4096},
        "disposition": {"enum": ["counted", "robot_internal_excluded", "support_ground_excluded"]},
        "normalized_pair": {"$ref": "#/$defs/pair"},
        "robot_collision": {"type": ["string", "null"], "maxLength": 4096},
        "sim_stamp_ns": {"type": "integer", "minimum": 1},
        "snapshot_sequence": {"type": "integer", "minimum": 1}
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_sha256", "files"],
      "properties": {
        "aggregate_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 4096},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "firstQualifyingContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callback_clock_offset_ns", "callback_clock_stamp_ns", "collector_sequence",
        "normalized_pair", "sim_stamp_ns", "stop_latency_clock_stamp_ns",
        "stop_latency_upper_bound_ns"
      ],
      "properties": {
        "callback_clock_offset_ns": {
          "type": "integer", "minimum": -220000000, "maximum": 220000000
        },
        "callback_clock_stamp_ns": {"type": "integer", "minimum": 0},
        "collector_sequence": {"type": "integer", "minimum": 1},
        "normalized_pair": {"$ref": "#/$defs/pair"},
        "sim_stamp_ns": {"type": "integer", "minimum": 1},
        "stop_latency_clock_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
        "stop_latency_upper_bound_ns": {
          "type": ["integer", "null"], "minimum": 0, "maximum": 100000000
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_stamp_ns", "latest_stamp_ns", "max_gap_ns", "regression_count", "sample_count"],
      "properties": {
        "first_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
        "latest_stamp_ns": {"type": ["integer", "null"], "minimum": 0},
        "max_gap_ns": {"type": "integer", "minimum": 0},
        "regression_count": {"type": "integer", "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 0}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pair": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "buffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_count", "capacity", "first_overflow_sequence", "first_overflow_stamp_ns",
        "ingress_count", "invalid_count", "overflow", "overflow_count", "retained_count"
      ],
      "properties": {
        "accepted_count": {"type": "integer", "minimum": 0},
        "capacity": {"type": "integer", "minimum": 1},
        "first_overflow_sequence": {"type": ["integer", "null"]},
        "first_overflow_stamp_ns": {"type": ["integer", "null"]},
        "ingress_count": {"type": "integer", "minimum": 0},
        "invalid_count": {"type": "integer", "minimum": 0},
        "overflow": {"type": "boolean"},
        "overflow_count": {"type": "integer", "minimum": 0},
        "retained_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
