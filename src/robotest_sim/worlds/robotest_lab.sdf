<?xml version="1.0"?>
<!--
  Copyright 2026 Hasan Ahmed
  SPDX-License-Identifier: Apache-2.0

  Original, network-independent Phase 1 test world. Every model is composed
  from SDF primitives; there are no Fuel or remote model references.
-->
<sdf version="1.10">
  <world name="robotest_lab">
    <!--
      A 2 ms step keeps the simple differential-drive/contact dynamics at
      500 Hz while leaving CPU headroom for software-rendered lidar in WSL2.
    -->
    <physics name="cpu_friendly_2ms" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 12</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 12</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.70 1</ambient>
            <diffuse>0.72 0.72 0.70 1</diffuse>
          </material>
        </visual>
      </link>
      <!--
        This permanent 10 Hz source keeps the merged Phase 3 entity-pose
        validation stream alive after a temporary scenario actor is deleted.
      -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>10</update_frequency>
        <static_publisher>false</static_publisher>
      </plugin>
    </model>

    <!-- Four overlapping boundary walls make escape impossible. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6.05 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.2 0.12 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.2 0.12 1.2</size></box></geometry>
          <material><ambient>0.30 0.38 0.48 1</ambient><diffuse>0.30 0.38 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -6.05 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.2 0.12 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.2 0.12 1.2</size></box></geometry>
          <material><ambient>0.30 0.38 0.48 1</ambient><diffuse>0.30 0.38 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>6.05 0 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.12 12.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 12.2 1.2</size></box></geometry>
          <material><ambient>0.30 0.38 0.48 1</ambient><diffuse>0.30 0.38 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-6.05 0 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.12 12.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.12 12.2 1.2</size></box></geometry>
          <material><ambient>0.30 0.38 0.48 1</ambient><diffuse>0.30 0.38 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A split divider leaves a repeatable 1.2 m navigation passage. -->
    <model name="divider_west">
      <static>true</static>
      <pose>-3.30 1.50 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.4 0.16 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.4 0.16 0.9</size></box></geometry>
          <material><ambient>0.68 0.38 0.15 1</ambient><diffuse>0.68 0.38 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_east">
      <static>true</static>
      <pose>3.30 1.50 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.4 0.16 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.4 0.16 0.9</size></box></geometry>
          <material><ambient>0.68 0.38 0.15 1</ambient><diffuse>0.68 0.38 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_west">
      <static>true</static>
      <pose>-3.8 -2.4 0.40 0 0 0.30</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 0.8</size></box></geometry>
          <material><ambient>0.65 0.18 0.16 1</ambient><diffuse>0.65 0.18 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_east">
      <static>true</static>
      <pose>3.7 3.7 0.50 0 0 -0.35</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.4 0.8 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.8 1.0</size></box></geometry>
          <material><ambient>0.18 0.45 0.30 1</ambient><diffuse>0.18 0.45 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder">
      <static>true</static>
      <pose>2.7 -3.5 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.45</radius><length>1.1</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.45</radius><length>1.1</length></cylinder></geometry>
          <material><ambient>0.20 0.34 0.66 1</ambient><diffuse>0.20 0.34 0.66 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
