<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Chassis dimensions and pose, in SI units. -->
  <xacro:property name="base_length" value="0.48"/>
  <xacro:property name="base_width" value="0.32"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_mass" value="8.0"/>
  <xacro:property name="base_center_z" value="0.135"/>

  <!-- Differential-drive geometry. -->
  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.35"/>
  <xacro:property name="wheel_separation" value="0.38"/>

  <!-- Two low-friction spherical support points keep the chassis level. -->
  <xacro:property name="caster_radius" value="0.035"/>
  <xacro:property name="caster_mass" value="0.08"/>
  <xacro:property name="caster_x" value="0.18"/>

  <!-- Sensor body properties. -->
  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.12"/>
  <xacro:property name="lidar_x" value="0.08"/>
  <xacro:property name="lidar_z" value="0.11"/>

  <xacro:property name="imu_x_size" value="0.04"/>
  <xacro:property name="imu_y_size" value="0.03"/>
  <xacro:property name="imu_z_size" value="0.015"/>
  <xacro:property name="imu_mass" value="0.05"/>
  <xacro:property name="imu_z" value="0.02"/>
</robot>
