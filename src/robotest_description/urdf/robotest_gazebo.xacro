<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="robotest_gazebo" params="topic_namespace enable_ground_truth">
    <!-- Keep named fixed links so Gazebo sensor frames and collisions remain stable. -->
    <gazebo reference="front_caster_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="rear_caster_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="lidar_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="imu_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="base_link">
      <material>Gazebo/Blue</material>
      <!-- Contact is limited to the chassis so normal wheel-ground support is quiet. -->
      <sensor name="chassis_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <contact>
          <!--
            URDF-to-SDF correctly lumps the massless base_footprint joint.
            sdformat gives the chassis collision this deterministic target name.
          -->
          <collision>base_footprint_fixed_joint_lump__base_link_collision_collision</collision>
          <topic>${topic_namespace}/validation/contacts</topic>
        </contact>
      </sensor>
    </gazebo>

    <gazebo reference="left_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="front_caster_link">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
    </gazebo>
    <gazebo reference="rear_caster_link">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
    </gazebo>

    <gazebo reference="lidar_link">
      <material>Gazebo/Orange</material>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <topic>${topic_namespace}/raw/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="imu_link">
      <material>Gazebo/Orange</material>
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>${topic_namespace}/raw/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>${topic_namespace}/cmd_vel</topic>
        <odom_topic>${topic_namespace}/raw/odom</odom_topic>
        <!-- Gazebo Transport TF is deliberately routed to an unbridged topic. -->
        <tf_topic>${topic_namespace}/internal/diff_drive_tf_unbridged</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>20</odom_publish_frequency>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>${topic_namespace}/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
        <update_rate>20</update_rate>
      </plugin>

      <xacro:if value="${enable_ground_truth}">
        <plugin filename="gz-sim-odometry-publisher-system"
                name="gz::sim::systems::OdometryPublisher">
          <dimensions>2</dimensions>
          <odom_frame>world</odom_frame>
          <robot_base_frame>base_footprint</robot_base_frame>
          <odom_topic>${topic_namespace}/validation/ground_truth</odom_topic>
          <!-- Validator truth must never compete for the ROS odom TF edge. -->
          <tf_topic>${topic_namespace}/internal/ground_truth_tf_unbridged</tf_topic>
          <odom_publish_frequency>20</odom_publish_frequency>
        </plugin>
      </xacro:if>
    </gazebo>
  </xacro:macro>
</robot>
