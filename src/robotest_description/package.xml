<package format="3">
  <name>robotest_description</name>
  <version>0.1.0</version>
  <description>
    Primitive differential-drive robot model and Gazebo Harmonic sensor extensions
    for RoboTest Lab.
  </description>

  <maintainer email="200383997+Hasan-Al-Hussein@users.noreply.github.com">Hasan Ahmed</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>joint_state_publisher</exec_depend>
