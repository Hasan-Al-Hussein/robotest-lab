{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotest-lab.invalid/schema/mission.schema.json",
  "title": "RoboTest mission and Phase 3 scenario",
  "oneOf": [
    {"$ref": "#/$defs/phase2"},
    {"$ref": "#/$defs/phase3_s1"},
    {"$ref": "#/$defs/phase3_s2"},
    {"$ref": "#/$defs/phase3_s3"},
    {"$ref": "#/$defs/phase3_s4"},
    {"$ref": "#/$defs/phase3_s5"}
  ],
  "$defs": {
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "yaw"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "yaw": {"type": "number"}
      }
    },
    "phase2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "mission_name", "mission_seed", "simulator_seed",
        "frame_id", "start_pose", "waypoints", "mission_timeout_sim_s",
        "wall_escape_timeout_s", "allowed_collision_count", "fault_schedule",
        "fault_seed", "expected_outcome", "retries"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "mission_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "mission_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "simulator_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "frame_id": {"const": "map"},
        "start_pose": {"$ref": "#/$defs/legacy_planar_pose"},
        "waypoints": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/legacy_planar_pose"}},
        "mission_timeout_sim_s": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 3600.0},
        "wall_escape_timeout_s": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 3600.0},
        "allowed_collision_count": {"const": 0},
        "fault_schedule": {"type": "null"},
        "fault_seed": {"type": "null"},
        "expected_outcome": {"const": "succeeded"},
        "retries": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "legacy_planar_pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "yaw"],
      "properties": {
        "x": {"type": "number", "minimum": -1000.0, "maximum": 1000.0},
        "y": {"type": "number", "minimum": -1000.0, "maximum": 1000.0},
        "yaw": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793}
      }
    },
    "start_pose": {
      "allOf": [
        {"$ref": "#/$defs/pose"},
        {"properties": {"x": {"const": 0.0}, "y": {"const": -3.5}, "yaw": {"const": 0.0}}}
      ]
    },
    "waypoints": {
      "type": "array",
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/pose"}, {"properties": {"x": {"const": -2.0}, "y": {"const": -3.5}, "yaw": {"const": 0.0}}}]},
        {"allOf": [{"$ref": "#/$defs/pose"}, {"properties": {"x": {"const": 0.0}, "y": {"const": 0.0}, "yaw": {"const": 0.0}}}]},
        {"allOf": [{"$ref": "#/$defs/pose"}, {"properties": {"x": {"const": 0.0}, "y": {"const": 3.5}, "yaw": {"const": 0.0}}}]}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "empty_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "faults"],
      "properties": {
        "schema_version": {"const": 1},
        "faults": {"type": "array", "maxItems": 0}
      }
    },
    "phase3_common": {
      "type": "object",
      "required": [
        "schema_version", "scenario_id", "scenario_name", "mission_seed",
        "simulator_seed", "scenario_controller_seed", "frame_id", "start_pose",
        "waypoints", "mission_timeout_sim_s", "wall_escape_timeout_s",
        "allowed_collision_count", "expected_outcome", "retries",
        "fault_schedule_sha256", "fault_seed"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "scenario_id": {"type": "integer", "minimum": 1, "maximum": 5},
        "scenario_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,63}$"},
        "mission_seed": {"const": 42},
        "simulator_seed": {"const": 42},
        "scenario_controller_seed": {"const": 42},
        "frame_id": {"const": "map"},
        "start_pose": {"$ref": "#/$defs/start_pose"},
        "waypoints": {"$ref": "#/$defs/waypoints"},
        "mission_timeout_sim_s": {"const": 180.0},
        "wall_escape_timeout_s": {"const": 300.0},
        "allowed_collision_count": {"const": 0},
        "expected_outcome": {"const": "succeeded"},
        "retries": {"const": 0},
        "fault_schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fault_seed": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295}
      }
    },
    "box_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "size_x_m", "size_y_m", "size_z_m"],
      "properties": {
        "type": {"const": "box"},
        "size_x_m": {"type": "number", "exclusiveMinimum": 0},
        "size_y_m": {"type": "number", "exclusiveMinimum": 0},
        "size_z_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "world_pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_m", "y_m", "z_m", "yaw_rad"],
      "properties": {
        "x_m": {"type": "number"},
        "y_m": {"type": "number"},
        "z_m": {"type": "number"},
        "yaw_rad": {"type": "number"}
      }
    },
    "lidar_fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "fault_id", "target", "mode", "start_offset_ns", "duration_ns", "seed", "parameters"],
      "properties": {
        "schema_version": {"const": 1},
        "fault_id": {"const": "scan_drop"},
        "target": {"const": 1},
        "mode": {"const": 1},
        "start_offset_ns": {"const": 10000000000},
        "duration_ns": {"const": 2000000000},
        "seed": {"const": 42},
        "parameters": {"type": "object", "additionalProperties": false, "maxProperties": 0}
      }
    },
    "odom_fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "fault_id", "target", "mode", "start_offset_ns", "duration_ns", "seed", "parameters"],
      "properties": {
        "schema_version": {"const": 1},
        "fault_id": {"const": "odom_drift"},
        "target": {"const": 2},
        "mode": {"const": 4},
        "start_offset_ns": {"const": 10000000000},
        "duration_ns": {"const": 20000000000},
        "seed": {"const": 42},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x_rate_nm_per_s", "yaw_rate_nrad_per_s"],
          "properties": {
            "x_rate_nm_per_s": {"const": 10000000},
            "yaw_rate_nrad_per_s": {"const": 5000000}
          }
        }
      }
    },
    "phase3_s1": {
      "allOf": [
        {"$ref": "#/$defs/phase3_common"},
        {
          "properties": {
            "scenario_id": {"const": 1},
            "scenario_name": {"const": "baseline_navigation"},
            "actor": {"type": "null"},
            "fault_schedule": {"$ref": "#/$defs/empty_schedule"},
            "fault_schedule_sha256": {"const": "26080d7dc8f4108a369962ecad1d2e29941a991af68beb415067eae1dc1de6f8"},
            "fault_seed": {"type": "null"}
          },
          "required": ["actor", "fault_schedule"]
        }
      ],
      "unevaluatedProperties": false
    },
    "phase3_s2": {
      "allOf": [
        {"$ref": "#/$defs/phase3_common"},
        {
          "properties": {
            "scenario_id": {"const": 2},
            "scenario_name": {"const": "deterministic_static_obstacle_replan"},
            "entity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "static", "geometry", "world_pose"],
              "properties": {
                "name": {"const": "phase3_static_block"},
                "static": {"const": true},
                "geometry": {"allOf": [{"$ref": "#/$defs/box_geometry"}, {"properties": {"size_x_m": {"const": 0.40}, "size_y_m": {"const": 0.40}, "size_z_m": {"const": 0.80}}}]},
                "world_pose": {"allOf": [{"$ref": "#/$defs/world_pose"}, {"properties": {"x_m": {"const": -1.0}, "y_m": {"const": -3.5}, "z_m": {"const": 0.4}, "yaw_rad": {"const": 0.0}}}]}
              }
            },
            "trigger": {
              "type": "object",
              "additionalProperties": false,
              "required": ["anchor", "target_offset_sim_s", "latest_first_observed_offset_sim_s", "required_leg_index"],
              "properties": {
                "anchor": {"const": "accepted_goal_t0"},
                "target_offset_sim_s": {"const": 2.0},
                "latest_first_observed_offset_sim_s": {"const": 2.25},
                "required_leg_index": {"const": 0}
              }
            },
            "fault_schedule": {"$ref": "#/$defs/empty_schedule"},
            "fault_schedule_sha256": {"const": "26080d7dc8f4108a369962ecad1d2e29941a991af68beb415067eae1dc1de6f8"},
            "fault_seed": {"type": "null"}
          },
          "required": ["entity", "trigger", "fault_schedule"]
        }
      ],
      "unevaluatedProperties": false
    },
    "phase3_s3": {
      "allOf": [
        {"$ref": "#/$defs/phase3_common"},
        {
          "properties": {
            "scenario_id": {"const": 3},
            "scenario_name": {"const": "deterministic_dynamic_obstacle"},
            "entity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "static", "pose_controlled", "geometry", "initial_world_pose"],
              "properties": {
                "name": {"const": "phase3_dynamic_block"},
                "static": {"const": true},
                "pose_controlled": {"const": true},
                "geometry": {"allOf": [{"$ref": "#/$defs/box_geometry"}, {"properties": {"size_x_m": {"const": 0.35}, "size_y_m": {"const": 0.35}, "size_z_m": {"const": 0.80}}}]},
                "initial_world_pose": {"allOf": [{"$ref": "#/$defs/world_pose"}, {"properties": {"x_m": {"const": -0.8}, "y_m": {"const": 1.5}, "z_m": {"const": 0.4}, "yaw_rad": {"const": 0.0}}}]}
              }
            },
            "trigger": {
              "type": "object",
              "additionalProperties": false,
              "required": ["anchor"],
              "properties": {"anchor": {"const": "first_feedback_transition_to_waypoint_index_2"}}
            },
            "control_rate_hz": {"const": 10.0},
            "move_1_duration_sim_s": {"const": 4.0},
            "dwell_duration_sim_s": {"const": 4.0},
            "move_2_duration_sim_s": {"const": 4.0},
            "fault_schedule": {"$ref": "#/$defs/empty_schedule"},
            "fault_schedule_sha256": {"const": "26080d7dc8f4108a369962ecad1d2e29941a991af68beb415067eae1dc1de6f8"},
            "fault_seed": {"type": "null"}
          },
          "required": ["entity", "trigger", "control_rate_hz", "move_1_duration_sim_s", "dwell_duration_sim_s", "move_2_duration_sim_s", "fault_schedule"]
        }
      ],
      "unevaluatedProperties": false
    },
    "phase3_s4": {
      "allOf": [
        {"$ref": "#/$defs/phase3_common"},
        {
          "properties": {
            "scenario_id": {"const": 4},
            "scenario_name": {"const": "temporary_lidar_dropout"},
            "actor": {"type": "null"},
            "fault_schedule_sha256": {"const": "5f93838ca7c0be214858ffe8f62fa351b82d260f6223f139dfaf6bd3dcd224c8"},
            "fault_seed": {"const": 42},
            "fault": {"$ref": "#/$defs/lidar_fault"}
          },
          "required": ["actor", "fault"]
        }
      ],
      "unevaluatedProperties": false
    },
    "phase3_s5": {
      "allOf": [
        {"$ref": "#/$defs/phase3_common"},
        {
          "properties": {
            "scenario_id": {"const": 5},
            "scenario_name": {"const": "deterministic_odometry_drift"},
            "actor": {"type": "null"},
            "fault_schedule_sha256": {"const": "3c72bc48e05221a52058112e58c94b578550deb2ee1ff4ad0d719675917335eb"},
            "fault_seed": {"const": 42},
            "fault": {"$ref": "#/$defs/odom_fault"}
          },
          "required": ["actor", "fault"]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
