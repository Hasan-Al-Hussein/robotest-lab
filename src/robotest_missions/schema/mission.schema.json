{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotest-lab.local/schema/mission-v1.json",
  "title": "RoboTest Lab Phase 2 mission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_name",
    "mission_seed",
    "simulator_seed",
    "frame_id",
    "start_pose",
    "waypoints",
    "mission_timeout_sim_s",
    "wall_escape_timeout_s",
    "allowed_collision_count",
    "fault_schedule",
    "fault_seed",
    "expected_outcome",
    "retries"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "mission_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "mission_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "simulator_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "frame_id": {"const": "map"},
    "start_pose": {"$ref": "#/$defs/planar_pose"},
    "waypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/planar_pose"}
    },
    "mission_timeout_sim_s": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "maximum": 3600.0
    },
    "wall_escape_timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "maximum": 3600.0
    },
    "allowed_collision_count": {"const": 0},
    "fault_schedule": {"type": "null"},
    "fault_seed": {"type": "null"},
    "expected_outcome": {"const": "succeeded"},
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    }
  },
  "$defs": {
    "planar_pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "yaw"],
      "properties": {
        "x": {"type": "number", "minimum": -1000.0, "maximum": 1000.0},
        "y": {"type": "number", "minimum": -1000.0, "maximum": 1000.0},
        "yaw": {
          "type": "number",
          "minimum": -3.141592653589793,
          "maximum": 3.141592653589793
        }
      }
    }
  }
}
