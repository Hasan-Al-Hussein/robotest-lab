{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotest-lab.local/schema/lifecycle-schedule-v1.json",
  "title": "RoboTest Lifecycle Sampling Schedule",
  "type": "object",
  "required": [
    "lifecycle_schedule_schema_version",
    "requested_stamps_ns",
    "run_id"
  ],
  "properties": {
    "lifecycle_schedule_schema_version": {"const": 1},
    "requested_stamps_ns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 96,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807
      },
      "$comment": "validate_schedule additionally requires strict monotonic increase"
    },
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "additionalProperties": false
}
